{
  "name": "whisperapp",
  "version": "2.0.1",
  "description": "WhisperApp - Electron + React + Tailwind",
  "main": "dist/main/main/main.js",
  "homepage": "./",
  "author": "Roman Barinov <rbarinov@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "webpack --mode production",
    "build:native": "bash native/build.sh",
    "build:main": "tsc -p tsconfig.main.json && esbuild src/main/preload.ts --bundle --platform=node --external:electron --outfile=dist/main/main/preload.js --format=cjs && npm run build:native",
    "dev": "npm run build:main && concurrently \"webpack --mode development --watch\" \"wait-on dist/renderer/index.html && electron .\"",
    "make": "electron-builder",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uiohook-napi": "^1.5.4"
  },
  "optionalDependencies": {
    "iohook-macos": "^1.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "html-webpack-plugin": "^5.5.3",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18",
    "wait-on": "^7.0.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
